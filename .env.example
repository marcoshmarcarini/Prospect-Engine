# =========================================================
# MÁQUINA DE PROSPECÇÃO AUTOMÁTICA - VARIÁVEIS DE AMBIENTE
# =========================================================

# Chave da API do Google Gemini (IA para redação do pitch de vendas)
GEMINI_API_KEY="AIzaSy..."

# Chave da API do Google Cloud com Places API ativada (para buscar empresas sem site)
GOOGLE_PLACES_API_KEY="AIzaSy..."

# Chave da API do Resend (para envio do relatório diário por e-mail)
RESEND_API_KEY="re_..."

# E-mail de destino que receberá o relatório diário com os links do WhatsApp
NOTIFICATION_EMAIL_TO="seu-email@exemplo.com"

# E-mail remetente verificado no Resend (ex: onboarding@resend.dev para testes ou seu_dominio.com)
NOTIFICATION_EMAIL_FROM="Prospecção Automática <onboarding@resend.dev>"

# Segredo de proteção para a rota de Cron na Vercel (Opcional, para evitar execuções não autorizadas)
# Authorization: Bearer seu_secret_aqui
CRON_SECRET="meu_segredo_super_seguro_123"

# Termo padrão de busca para o Cron Job diário
DEFAULT_SEARCH_TERM="Marmoraria em Cachoeiro de Itapemirim"

# Nome do seu serviço ou empresa para contextualizar o pitch do Gemini (ex: "Studio Web Express")
YOUR_NAME_OR_BRAND="Marcos Henrique, Especialista em Sites Rápidos"

# URL da aplicação
APP_URL="http://localhost:3000"
